{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist/client",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tredo-ebj9.onrender.com/api/:path*"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://tredo-ebj9.onrender.com/demo/:path*"
    }
  ]
}
